<%
/*
 * One small inline icon, by name. Kept in a partial because the same glyphs are
 * used on the gallery cards, the 3D Geometry and Gaussian Splats cards, and in
 * each page's symbol key — so a change lands everywhere at once.
 *   cube     — a 3D model      points   — a Gaussian splat (point cloud)
 *   download — files to grab   cursor   — "this is clickable"
 *   image / video — what's inside a gallery project
 */
var _n = name;
%>
<% if (_n === 'cube') { %><svg class="ic ic-cube" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 2.6 20.4 7.3v9.4L12 21.4 3.6 16.7V7.3z"/><path d="M3.6 7.3 12 12l8.4-4.7M12 12v9.4"/></svg><% } %><% if (_n === 'points') { %><svg class="ic ic-points" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><circle cx="6" cy="9.5" r="1.35"/><circle cx="10.2" cy="6.2" r="1.15"/><circle cx="14.4" cy="7.8" r="1.45"/><circle cx="18.4" cy="10.4" r="1.2"/><circle cx="8.2" cy="13.4" r="1.5"/><circle cx="12.3" cy="11.4" r="1.2"/><circle cx="16.4" cy="14.4" r="1.3"/><circle cx="7" cy="17.6" r="1.15"/><circle cx="11.4" cy="16.6" r="1.45"/><circle cx="15.6" cy="18.6" r="1.15"/></svg><% } %><% if (_n === 'download') { %><svg class="ic ic-download" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M11 3h2v7h3.2L12 15.2 7.8 10H11z"/><path d="M4.5 17.5h15V20h-15z"/></svg><% } %><% if (_n === 'cursor') { %><svg class="ic ic-cursor" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M6 2.6v15.1l3.9-3.6 2.5 5.6 2.4-1.1-2.5-5.5h5.2z"/></svg><% } %><% if (_n === 'image') { %><svg class="ic ic-image" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M21 19V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg><% } %><% if (_n === 'video') { %><svg class="ic ic-video" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M17 10.5V7a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-3.5l4 4v-11l-4 4z"/></svg><% } %>
