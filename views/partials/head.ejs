    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheet.css">
    <link rel="stylesheet" href="/css/site.css">
    <style id="theme-vars"><%- (typeof themeCss !== 'undefined' && themeCss) ? themeCss : '' %></style>
    <title><%= typeof title !== 'undefined' ? title : 'Document' %></title>
    <%
      // Social-share (Open Graph / Twitter) tags. Values come from the settings
      // editable at /admin/social, with sensible fallbacks. A page can override
      // any of them per-URL by setting res.locals.og to an object with title,
      // description, image and/or url — each Gaussian-splat page does this so a
      // shared splat link previews itself. og:url and og:image are made absolute
      // from the request base URL. Values are auto-escaped on output. The
      // preview-bot allow-list lives in middleware/gate.js.
      var _s = (typeof settings !== 'undefined' && settings) ? settings : {};
      var _ovr = (typeof og !== 'undefined' && og) ? og : {};
      var _ogBase = (typeof baseUrl !== 'undefined' && baseUrl) ? baseUrl : '';
      var _pick = function (a, b) { return (a != null && String(a).trim()) ? a : b; };
      var _ogTitle = _pick(_ovr.title, _pick(_s.share_title, ((typeof title !== 'undefined' && title) ? title : (_s.site_title || 'Max Ammon'))));
      var _ogDesc = _pick(_ovr.description, _s.share_description || '');
      var _ogImgRaw = _ovr.image || _s.share_image || _s.about_banner || '';
      var _ogImg = _ogImgRaw ? (/^https?:\/\//i.test(_ogImgRaw) ? _ogImgRaw : _ogBase + _ogImgRaw) : '';
      var _ogUrlPath = _pick(_ovr.url, ((typeof currentPath !== 'undefined' && currentPath) ? currentPath : '/'));
      var _ogUrl = /^https?:\/\//i.test(_ogUrlPath) ? _ogUrlPath : (_ogBase + _ogUrlPath);
      var _ogSite = _s.site_title || 'Max Ammon';
    %>
    <% if (_ogDesc) { %><meta name="description" content="<%= _ogDesc %>"><% } %>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="<%= _ogSite %>">
    <meta property="og:title" content="<%= _ogTitle %>">
    <% if (_ogDesc) { %><meta property="og:description" content="<%= _ogDesc %>"><% } %>
    <meta property="og:url" content="<%= _ogUrl %>">
    <% if (_ogImg) { %><meta property="og:image" content="<%= _ogImg %>"><% } %>
    <meta name="twitter:card" content="<%= _ogImg ? 'summary_large_image' : 'summary' %>">
    <meta name="twitter:title" content="<%= _ogTitle %>">
    <% if (_ogDesc) { %><meta name="twitter:description" content="<%= _ogDesc %>"><% } %>
    <% if (_ogImg) { %><meta name="twitter:image" content="<%= _ogImg %>"><% } %>
