<% var variant = (typeof navVariant !== 'undefined') ? navVariant : 'main'; %>
    <nav>
        <div id="name" style="display:flex; gap:200px" class="headerbox">
            <h1 class="sitetitle"><a href="/"><%= settings.site_title %></a></h1>
            <h1 class="jobtitle"><%= settings.job_title %></h1>
        </div>
<%# The three showcase pages share one header listing all of them in a fixed
    order, with the page you're on glowing via the same .nav-current style the
    main page's scrollspy uses. %>
<% if (variant === 'gallery' || variant === 'photography' || variant === 'splats' || variant === 'geometry') {
     var showcase = [
       { key: 'gallery', href: '/gallery', label: 'Project Gallery' },
       { key: 'geometry', href: '/geometry', label: '3D Geometry' },
       { key: 'splats', href: '/splats', label: 'Gaussian Splats' },
       { key: 'photography', href: '/photography', label: 'Photography' },
     ];
%>
        <ul style="font-size:2cap;max-width: max-content;" class="headerbox nopadding nav-showcase">
            <% showcase.forEach(function (s) { var here = s.key === variant; %>
            <li><a href="<%= s.href %>"<%- here ? ' class="nav-current" aria-current="page"' : '' %>><%= s.label %></a></li>
            <% }); %>
            <li><a href="/" rel="noopener noreferrer">go back to main site</a></li>
        </ul>
<% } else if (variant === 'back') { %>
        <ul style="font-size:2cap;max-width: max-content;" class="headerbox nopadding">
            <li><a href="/" rel="noopener noreferrer">go back to main site</a></li>
        </ul>
<% } else { %>
        <ul style="font-size:2cap" class="headerbox nopadding">
            <li><a href="#demo">Demo</a></li>
            <li><a href="#skills">My Skills</a></li>
            <li><a href="#about">About Me</a></li>
            <li><a href="#contact">Contact</a></li>
            <li><a href="/gallery" rel="noopener noreferrer">Project Gallery</a></li>
        </ul>
<% } %>
    </nav>
<%# The shrink-on-scroll behaviour lives with the header itself, so every page
    that uses this nav gets it — it used to be included per page, which meant
    newer pages (Photography, Splats, 3D Geometry, Demo Archive) silently
    didn't shrink. %>
<%- include('scroll-nav') %>
