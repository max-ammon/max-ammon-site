<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/admin-head', { title: title }) %>
<style>
  .frame-grid { list-style: none; padding: 0; margin: 0 0 22px; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
  .frame-card { background: var(--a-surface); border: 1px solid var(--a-border); border-radius: 8px; padding: 8px; display: flex; flex-direction: column; gap: 7px; }
  .frame-shot { position: relative; background: rgba(255,255,255,0.06); border-radius: 5px; overflow: hidden; aspect-ratio: 16 / 9; display: flex; align-items: center; justify-content: center; }
  .frame-shot img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .frame-no { position: absolute; top: 4px; left: 4px; background: rgba(0,0,0,0.66); color: #fff; font-size: 0.66rem; font-weight: 700; line-height: 1; padding: 3px 5px; border-radius: 4px; }
  .frame-tools { display: flex; gap: 4px; align-items: center; }
  .frame-tools form { margin: 0; }
  .frame-tools button { min-width: 28px; }
  .frame-tools .spacer { flex: 1; }
  .danger { color: #d9534f; }

  .fallback-note { display: flex; gap: 14px; align-items: center; }
  .fallback-note img { width: 160px; border-radius: 6px; border: 1px solid var(--a-border); display: block; }
</style>
</head>
<body class="admin">
<%- include('../partials/admin-topbar') %>
    <main class="admin-main">
        <p class="muted"><a href="/admin">← Dashboard</a></p>
        <h1><%= title %></h1>
        <%# One page for every slot, so what one of these pictures is called comes
            from the slot rather than being written into the page. %>
        <% var noun = slot.noun || 'frame'; var nouns = noun + 's'; %>
        <p class="muted">
          Give the <strong><%= slot.section %></strong> picture a set of <%= nouns %> and it <%= slot.plays %>
          <%= slot.minimum === 1 ? 'With none here' : 'With fewer than two ' + nouns + ' here' %>, the section shows
          what it shows without them, so removing them all is a safe way back.
        </p>
        <% if (saved) { %><div class="alert ok">Saved. <a href="/#skills" target="_blank" rel="noopener">View site ↗</a></div><% } %>
        <% if (err === 'nofile') { %><div class="alert error">Nothing was added — choose PNG, JPG or WebP images.</div><% } %>
        <% if (err === 'slit') { %><div class="alert error">Slit width has to be a number between 0.5 and 50 percent.</div><% } %>

        <% if (slot.baseRequired && frames.length && !base) { %>
          <div class="alert">These <%= nouns %> are cut into a background picture, and there isn't one yet — until you
          set one below, the section carries on showing what it showed before.</div>
        <% } %>

        <% if (frames.length === 1 && slot.minimum > 1) { %>
          <div class="alert">One <%= noun %> on its own does not play. Add at least one more, or remove it to go back to the single picture.</div>
        <% } %>

        <% if (frames.length) { %>
        <p class="muted"><strong><%= frames.length %></strong> <%= frames.length === 1 ? noun : nouns %> — they are used in the order shown.</p>
        <ul class="frame-grid">
            <% frames.forEach(function (f, i) { %>
            <li class="frame-card">
                <div class="frame-shot">
                    <img src="<%= f.file_path %>" alt="" loading="lazy" decoding="async">
                    <span class="frame-no"><%= i + 1 %></span>
                </div>
                <div class="frame-tools">
                    <form method="post" action="/admin/skill-frames/<%= slug %>/<%= f.id %>/move" class="inline">
                        <input type="hidden" name="dir" value="up">
                        <button class="btn-link btn-sm" type="submit" title="Move earlier" <%= i === 0 ? 'disabled' : '' %>>←</button>
                    </form>
                    <form method="post" action="/admin/skill-frames/<%= slug %>/<%= f.id %>/move" class="inline">
                        <input type="hidden" name="dir" value="down">
                        <button class="btn-link btn-sm" type="submit" title="Move later" <%= i === frames.length - 1 ? 'disabled' : '' %>>→</button>
                    </form>
                    <span class="spacer"></span>
                    <form method="post" action="/admin/skill-frames/<%= slug %>/<%= f.id %>/delete" class="inline" onsubmit="return confirm('Remove <%= noun %> <%= i + 1 %>?');">
                        <button class="btn-link btn-sm danger" type="submit" title="Remove this <%= noun %>">Delete</button>
                    </form>
                </div>
            </li>
            <% }); %>
        </ul>
        <% } else { %>
        <div class="card-inset fallback-note">
            <% if (fallback) { %><img src="<%= fallback %>" alt=""><% } %>
            <p class="muted" style="margin:0;">No <%= nouns %> yet, so the section shows this single picture. It stays the fallback: add <%= nouns %> below and they take over, remove them all and it comes back. Change the picture itself under <a href="/admin/images/skills">Skills images</a>.</p>
        </div>
        <% } %>

        <% if (slot.baseKey) { %>
        <div class="card-inset">
            <h3>Background picture <span class="muted" style="font-weight:400;">— <%= slot.baseRequired ? 'required' : 'optional' %></span></h3>
            <p class="muted" style="margin-top:0;">
                <% if (slot.baseRequired) { %>
                    The slits are cut into this picture: every layer is drawn over it and shows only through its own
                    slit, so without one there is nothing for them to cut into and the section carries on as before.
                    It and the layers are all served at full size, which is what keeps a slit as sharp as the picture
                    around it.
                <% } else { %>
                    Optional. Give the sequence a still to play on and each frame only has to carry what actually
                    changes — transparent everywhere else, which is far lighter than a folder of complete pictures.
                    The background is served at full size and the frames over it at up to 2000px, so the detail comes
                    from the one picture that is downloaded once rather than from every frame.
                <% } %>
                Both this page and the other one for this picture set the same background, so it only has to be
                uploaded once.
            </p>
            <% if (base) { %>
            <div class="fallback-note">
                <img src="<%= base %>" alt="">
                <form method="post" action="/admin/skill-frames/<%= slug %>/base/delete" class="inline" onsubmit="return confirm('Remove the background picture? Everything built on it goes back to the single picture.');">
                    <button class="btn-link danger" type="submit">Remove background</button>
                </form>
            </div>
            <% } %>
            <form method="post" action="/admin/skill-frames/<%= slug %>/base" enctype="multipart/form-data" style="margin-top:10px;">
                <label><%= base ? 'Replace background' : 'Background picture' %>
                    <input type="file" name="base" accept="image/*" required>
                </label>
                <p class="muted" style="margin-top:6px;">
                    Give it the same shape as the <%= nouns %> — they are stretched onto it, so anything of a different
                    proportion puts everything out of register.
                </p>
                <button class="btn" type="submit"><%= base ? 'Replace background' : 'Set background' %></button>
            </form>
        </div>
        <% } %>

        <% if (slot.slitKey) { %>
        <div class="card-inset">
            <h3>Slit width</h3>
            <form method="post" action="/admin/skill-frames/<%= slug %>/slit">
                <label>Percent of the picture's width
                    <input type="number" name="slit" value="<%= slit %>" min="0.5" max="50" step="0.1" required style="max-width:120px;">
                </label>
                <p class="muted" style="margin-top:6px;">
                    One slit, as a share of the picture rather than in pixels, so it is the same slice of it on every
                    screen. <strong>6.5</strong> is a 250px slit in a 3840px render. The band is this times however many
                    layers there are — <%= frames.length || 'no' %> at the moment<% if (frames.length) { %>, so
                    <strong><%= (Number(slit) * frames.length).toFixed(1) %>%</strong> of the picture is slits<% } %>.
                </p>
                <button class="btn" type="submit">Save slit width</button>
            </form>
        </div>
        <% } %>

        <div class="card-inset">
            <h3><%= frames.length ? 'Add more ' + nouns : 'Add ' + nouns %></h3>
            <form method="post" action="/admin/skill-frames/<%= slug %>" enctype="multipart/form-data">
                <label><%= nouns.charAt(0).toUpperCase() + nouns.slice(1) %>
                    <input type="file" name="frames" accept="image/*" multiple required>
                </label>
                <p class="muted" style="margin-top:6px;">
                    Choose them all at once — they are sorted by filename, so <code><%= noun %>_02</code> lands before
                    <code><%= noun %>_10</code>. New ones are added after those already here.
                    <% if (slot.slitKey) { %>
                        Each layer is the whole picture, the same size and shape as the background, and is served at
                        full size — a slit shows its layer at the scale of the picture around it, so nothing smaller
                        would do. They are downloaded when a visitor reaches the section, so a set of six full-size
                        renders is what it sounds like; keep them as lean as they can be while staying sharp.
                    <% } else { %>
                        Every frame is downloaded when a visitor reaches the section, so keep them a sensible size:
                        they are served at up to 2000px wide, and sixteen large stills add up.
                    <% } %>
                </p>
                <button class="btn" type="submit">Add <%= nouns %></button>
            </form>
        </div>

        <% if (frames.length) { %>
        <form method="post" action="/admin/skill-frames/<%= slug %>/clear" style="margin-top:18px;" onsubmit="return confirm('Remove all <%= frames.length %> <%= nouns %>? The section goes back to what it shows without them.');">
            <button class="btn-link danger" type="submit">Remove all <%= nouns %></button>
        </form>
        <% } %>
    </main>
</body>
</html>
