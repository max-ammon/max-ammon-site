<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/admin-head', { title: title }) %>
</head>
<body class="admin">
<%- include('../partials/admin-topbar') %>
    <main class="admin-main">
        <h1>Welcome, <%= user.username %></h1>
        <p class="muted">Manage your site's text, colours, gallery and messages here.</p>

        <%# One page still, in groups: everything visible, nothing behind a click. %>
        <% groups.forEach(function (g) { %>
            <section class="card-group">
                <h2><%= g.title %></h2>
                <div class="card-grid">
                    <% g.items.forEach(function (s) { %>
                        <a class="card" href="<%= s.href %>">
                            <h3><%= s.title %></h3>
                            <p><%= s.desc %></p>
                        </a>
                    <% }); %>
                </div>
            </section>
        <% }); %>
        <% if (!groups.length) { %>
            <p class="muted" style="margin-top:24px;">Editing tools will appear here as they are built.</p>
        <% } %>
    </main>
</body>
</html>
