<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head', { title: title }) %>
    <link rel="stylesheet" href="/css/splat-view.css">
    <link rel="stylesheet" href="/css/geometry-view.css">
</head>
<body class="splat-body">
    <header class="splat-bar">
        <a class="splat-back" href="<%= back.href %>">&larr; <%= back.label %></a>
        <div class="splat-titlebox">
            <span class="splat-title"><%= model.title %></span>
            <% if (model.year) { %><span class="splat-year"><%= model.year %></span><% } %>
        </div>
        <div class="splat-tools">
            <% if (isOwner) { %>
            <label class="splat-exposure" title="Exposure — only you see this while logged in; it saves automatically">
                <span class="splat-exposure-ic" aria-hidden="true">&#9728;</span>
                <input type="range" id="geoExposure" min="0.1" max="3" step="0.05" value="<%= model.exposure || 1 %>" aria-label="Exposure">
            </label>
            <label class="splat-exposure" title="Environment light strength — only you see this while logged in; it saves automatically">
                <span class="splat-exposure-ic" aria-hidden="true">&#9678;</span>
                <input type="range" id="geoEnv" min="0" max="4" step="0.05" value="<%= model.env_intensity || 1 %>" aria-label="Environment light">
            </label>
            <button id="geoLightBtn" type="button" title="Lighting rig — only you see this; changes save automatically">Light</button>
            <button id="geoMatBtn" type="button" title="Material overrides — only you see this; changes save automatically">Material</button>
            <button id="geoSetView" type="button" title="Save the current camera as the view everyone starts at">Set default view</button>
            <button id="geoClearView" type="button" title="Go back to automatic framing"<%= model.view ? '' : ' hidden' %>>Clear</button>
            <% } %>
            <% if (model.wireframe_ok) { %><button id="geoWire" type="button" title="Toggle wireframe">Wireframe</button><% } %>
            <button id="geoReset" type="button">Reset view</button>
            <button id="geoFull" type="button" title="Fullscreen" aria-label="Fullscreen">&#9974;</button>
        </div>
    </header>

    <main class="splat-stage" id="geoStage"
          data-src="<%= model.model_url %>"
          data-id="<%= model.id %>"
          data-exposure="<%= model.exposure || 1 %>"
          data-env="<%= model.env_intensity || 1 %>"
          data-background="<%= model.background || '' %>"
          data-autorotate="<%= model.auto_rotate ? '1' : '0' %>"
          data-key-intensity="<%= model.key_intensity == null ? 0 : model.key_intensity %>"
          data-key-color="<%= model.key_color || '#ffffff' %>"
          data-key-azimuth="<%= model.key_azimuth == null ? 135 : model.key_azimuth %>"
          data-key-elevation="<%= model.key_elevation == null ? 45 : model.key_elevation %>"
          data-env-color="<%= model.env_color || '#ffffff' %>"
          data-smooth="<%= model.smooth_normals ? '1' : '0' %>"
          data-metalness="<%= model.metalness == null ? '' : model.metalness %>"
          data-roughness="<%= model.roughness == null ? '' : model.roughness %>"
          data-view="<%= model.view ? JSON.stringify(model.view) : '' %>">
        <canvas id="geoCanvas"></canvas>

        <div class="splat-loading" id="geoLoading"<% if (model.thumb_path) { %> style="background-image: url('<%= imgUrl(model.thumb_path, 1600) %>');"<% } %>>
            <div class="splat-loading-inner">
                <div class="splat-progress"><span class="splat-progress-bar" id="geoBar"></span></div>
                <div class="splat-progress-label" id="geoLabel">Loading&hellip;</div>
            </div>
        </div>

        <div class="splat-hint" id="geoHint">Drag to orbit &middot; scroll to zoom &middot; right-drag to pan</div>
        <div class="geo-stats" id="geoStats" hidden></div>

        <% if (isOwner) { %>
        <%# Owner-only lighting rig, saved per model and shown to every visitor.
            The key light starts at 0 so a model lit purely by the environment is
            unchanged until you dial one in. %>
        <div class="geo-mat geo-light" id="geoLightPanel" hidden>
            <div class="gm-head">Lighting <span class="gm-note">only you see this</span></div>
            <div class="gm-sub">Key light</div>
            <label class="gm-row">Strength
                <input type="range" id="geoKeyInt" min="0" max="10" step="0.05" value="<%= model.key_intensity == null ? 0 : model.key_intensity %>">
                <output id="geoKeyIntOut"></output>
            </label>
            <label class="gm-row">Rotation
                <input type="range" id="geoKeyAz" min="0" max="360" step="1" value="<%= model.key_azimuth == null ? 135 : model.key_azimuth %>">
                <output id="geoKeyAzOut"></output>
            </label>
            <label class="gm-row">Height
                <input type="range" id="geoKeyEl" min="-89" max="89" step="1" value="<%= model.key_elevation == null ? 45 : model.key_elevation %>">
                <output id="geoKeyElOut"></output>
            </label>
            <label class="gm-row">Colour
                <input type="color" id="geoKeyCol" value="<%= model.key_color || '#ffffff' %>">
            </label>

            <div class="gm-sub">Environment</div>
            <label class="gm-row">Brightness
                <input type="range" id="geoEnvInt" min="0" max="4" step="0.05" value="<%= model.env_intensity == null ? 1 : model.env_intensity %>">
                <output id="geoEnvIntOut"></output>
            </label>
            <label class="gm-row">Colour
                <input type="color" id="geoEnvCol" value="<%= model.env_color || '#ffffff' %>">
            </label>

            <div class="gm-row gm-actions">
                <button type="button" id="geoLightReset">Reset lighting</button>
            </div>
        </div>

        <%# Owner-only material overrides. Exports often arrive fully metallic
            (glTF's default when metallicFactor is omitted), which reads dark and
            mirror-like, or without vertex normals, which shades faceted. %>
        <div class="geo-mat" id="geoMatPanel" hidden>
            <div class="gm-head">Material <span class="gm-note">only you see this</span></div>
            <label class="gm-row gm-check"><input type="checkbox" id="geoSmooth"<%= model.smooth_normals ? ' checked' : '' %>> Smooth shading</label>
            <label class="gm-row">Metalness
                <input type="range" id="geoMetal" min="0" max="1" step="0.01" value="<%= model.metalness == null ? 0 : model.metalness %>">
                <output id="geoMetalOut"></output>
            </label>
            <label class="gm-row">Roughness
                <input type="range" id="geoRough" min="0" max="1" step="0.01" value="<%= model.roughness == null ? 0.5 : model.roughness %>">
                <output id="geoRoughOut"></output>
            </label>
            <div class="gm-row gm-actions">
                <button type="button" id="geoMatReset">Use file values</button>
            </div>
            <div class="gm-file" id="geoMatInfo">reading file…</div>
        </div>
        <% } %>
        <% if (model.description) { %>
        <div class="splat-caption"><%- nl2br(model.description) %></div>
        <% } %>
        <div class="splat-error" id="geoError" hidden></div>
    </main>

    <%# three.js is an ES module, so it needs an import map. Both entries point at
        this server (script-src 'self'); nothing is fetched from a CDN. %>
    <script type="importmap">
    {
        "imports": {
            "three": "/vendor/three/build/three.module.min.js",
            "three/addons/": "/vendor/three/examples/jsm/"
        }
    }
    </script>
    <script type="module" src="/js/geometry-viewer.js"></script>
</body>
</html>
