<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head', { title: title }) %>
    <link rel="stylesheet" href="/css/splat-view.css">
</head>
<body class="splat-body">
    <header class="splat-bar">
        <a class="splat-back" href="<%= back.href %>">&larr; <%= back.label %></a>
        <div class="splat-titlebox">
            <span class="splat-title"><%= splat.title %></span>
            <% if (splat.year) { %><span class="splat-year"><%= splat.year %></span><% } %>
        </div>
        <div class="splat-tools">
            <% if (isOwner) { %>
            <label class="splat-exposure" title="Exposure (brightness) — only you see this while logged in, and it saves automatically as you drag">
                <span class="splat-exposure-ic" aria-hidden="true">&#9728;</span>
                <input type="range" id="splatExposure" min="0.2" max="3" step="0.05" value="<%= splat.exposure || 1 %>" aria-label="Exposure">
            </label>
            <button id="splatColourBtn" type="button" title="White balance and tint — only you see this; changes save automatically">Colour</button>
            <button id="splatLookBtn" type="button" title="How large and how opaque the splats themselves are drawn — only you see this; changes save automatically">Splats</button>
            <% if (splat.background_url) { %><button id="splatBackdropBtn" type="button" title="Aim the 360 backdrop — only you see this; it saves automatically">Backdrop</button><% } %>
            <button id="splatSetView" type="button" title="Save the current camera as the view everyone starts at">Set default view</button>
            <button id="splatClearView" type="button" title="Go back to automatic framing"<%= splat.view ? '' : ' hidden' %>>Clear</button>
            <% } %>
            <button id="splatReset" type="button">Reset view</button>
            <button id="splatFull" type="button" title="Fullscreen" aria-label="Fullscreen">&#9974;</button>
        </div>
    </header>

    <main class="splat-stage" id="splatStage">
        <canvas id="splatCanvas"></canvas>

        <div class="splat-loading" id="splatLoading"<% if (splat.thumb_path) { %> style="background-image: url('<%= imgUrl(splat.thumb_path, 1600) %>');"<% } %>>
            <div class="splat-loading-inner">
                <div class="splat-progress"><span class="splat-progress-bar" id="splatBar"></span></div>
                <div class="splat-progress-label" id="splatLabel">Loading&hellip;</div>
            </div>
        </div>

        <div class="splat-hint" id="splatHint">Drag to orbit &middot; scroll to zoom &middot; right-drag to pan</div>
        <% if (isOwner) { %>
        <%# What the adaptive quality settled on — only you see this. %>
        <div class="splat-quality" id="splatQuality" hidden></div>

        <%# Owner-only colour correction. Captures often come out with a cast
            from the lighting they were shot under; these two save per splat and
            are applied for every visitor. %>
        <div class="view-panel" id="splatColourPanel" hidden>
            <div class="gm-head">Colour <span class="gm-note">only you see this</span></div>
            <label class="gm-row">Warmth
                <input type="range" id="splatWb" min="-1" max="1" step="0.01" value="<%= splat.white_balance || 0 %>">
                <output id="splatWbOut"></output>
            </label>
            <label class="gm-row">Tint
                <input type="range" id="splatTint" min="-1" max="1" step="0.01" value="<%= splat.tint || 0 %>">
                <output id="splatTintOut"></output>
            </label>
            <%# The tonal half: the three bands and gamma, on top of the exposure
                in the bar. They are applied where the finished picture exists —
                the tone-mapping pass — so they need a GPU that can render to a
                float buffer; the note below appears where one is missing. %>
            <label class="gm-row">Shadows
                <input type="range" id="splatShadows" min="-1" max="1" step="0.01" value="<%= splat.grade_shadows || 0 %>">
                <output id="splatShadowsOut"></output>
            </label>
            <label class="gm-row">Mids
                <input type="range" id="splatMids" min="-1" max="1" step="0.01" value="<%= splat.grade_mids || 0 %>">
                <output id="splatMidsOut"></output>
            </label>
            <label class="gm-row">Highlights
                <input type="range" id="splatHighs" min="-1" max="1" step="0.01" value="<%= splat.grade_highs || 0 %>">
                <output id="splatHighsOut"></output>
            </label>
            <label class="gm-row">Gamma
                <input type="range" id="splatGamma" min="0.5" max="2" step="0.01" value="<%= splat.grade_gamma || 1 %>">
                <output id="splatGammaOut"></output>
            </label>
            <div class="gm-row gm-actions">
                <button type="button" id="splatGradeReset">Neutral</button>
            </div>
            <div class="gm-file">Warmth runs blue &rarr; orange, tint green &rarr; magenta; brightness stays put either way. The three bands lift or lower the dark, middle and bright parts of what is on screen, and gamma bends everything between black and white.</div>
            <div class="gm-file" id="splatToneNote" hidden>This GPU can't render to a float buffer, so the viewer composites straight to the screen — warmth and tint still apply, the four tonal sliders don't.</div>
        </div>

        <%# Owner-only look of the splats themselves: how large the discs the
            capture is made of are drawn, and how opaque. Both are multipliers on
            what was captured, saved per splat — sparse captures close up as size
            rises, and opacity is what decides whether the cloud reads as solid
            or as something you can see into. %>
        <div class="view-panel" id="splatLookPanel" hidden>
            <div class="gm-head">Splats <span class="gm-note">only you see this</span></div>
            <label class="gm-row">Size
                <input type="range" id="splatSize" min="0.2" max="2" step="0.01" value="<%= splat.splat_scale || 1 %>">
                <output id="splatSizeOut"></output>
            </label>
            <label class="gm-row">Opacity
                <input type="range" id="splatOpacity" min="0.1" max="2" step="0.01" value="<%= splat.splat_alpha || 1 %>">
                <output id="splatOpacityOut"></output>
            </label>
            <div class="gm-row gm-actions">
                <button type="button" id="splatSizeReset">Size as captured</button>
                <button type="button" id="splatOpacityReset">Opacity as captured</button>
            </div>
            <div class="gm-file">1× is the capture untouched. Larger size closes the gaps in a sparse capture and costs more to draw; smaller opens it into the points it is made of. Opacity below 1 makes the whole cloud see-through; above it, faint splats firm up (a splat never goes past solid).</div>
        </div>

        <%# Owner-only aim for the 360 backdrop. A panorama faces wherever the
            camera did when it was shot, which is rarely where you want it. %>
        <% if (splat.background_url) { %>
        <div class="view-panel" id="splatBackdropPanel" hidden>
            <div class="gm-head">Backdrop <span class="gm-note">only you see this</span></div>
            <label class="gm-row">Rotation
                <input type="range" id="splatBgYaw" min="0" max="1" step="0.002" value="<%= splat.background_yaw || 0 %>">
                <output id="splatBgYawOut"></output>
            </label>
            <div class="gm-row gm-actions">
                <button type="button" id="splatBgReset">Reset</button>
            </div>
            <div class="gm-file">Turns the panorama around you. Drag until the part you want sits behind the capture.</div>
        </div>
        <% } %>
        <% } %>
        <div class="splat-mobile-note" id="splatMobileNote">Detail eases off while you drag and sharpens again a moment after you let go.</div>
        <% if (splat.description) { %>
        <div class="splat-caption"><%- nl2br(splat.description) %></div>
        <% } %>
        <div class="splat-error" id="splatError" hidden></div>
    </main>

    <script src="/js/splat-viewer.js"
            data-src="<%= splat.splat_url %>"
            data-format="<%= splat.splat_format %>"
            data-flip="<%= splat.flip_up ? '1' : '0' %>"
            data-exposure="<%= splat.exposure || 1 %>"
            data-splat-scale="<%= splat.splat_scale || 1 %>"
            data-splat-alpha="<%= splat.splat_alpha || 1 %>"
            data-bg="<%= splat.background_url %>"
            data-bg-yaw="<%= splat.background_yaw || 0 %>"
            data-wb="<%= splat.white_balance || 0 %>"
            data-tint="<%= splat.tint || 0 %>"
            data-shadows="<%= splat.grade_shadows || 0 %>"
            data-mids="<%= splat.grade_mids || 0 %>"
            data-highs="<%= splat.grade_highs || 0 %>"
            data-gamma="<%= splat.grade_gamma || 1 %>"
            data-view="<%= splat.view ? JSON.stringify(splat.view) : '' %>"
            data-id="<%= splat.id %>"></script>
</body>
</html>
