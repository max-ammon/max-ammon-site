<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head', { title: title }) %>
    <link rel="stylesheet" href="/css/splat-view.css">
</head>
<body class="splat-body">
    <header class="splat-bar">
        <a class="splat-back" href="<%= back.href %>">&larr; <%= back.label %></a>
        <div class="splat-titlebox">
            <span class="splat-title"><%= splat.title %></span>
            <% if (splat.year) { %><span class="splat-year"><%= splat.year %></span><% } %>
        </div>
        <div class="splat-tools">
            <% if (isOwner) { %>
            <label class="splat-exposure" title="Exposure (brightness) — only you see this while logged in, and it saves automatically as you drag">
                <span class="splat-exposure-ic" aria-hidden="true">&#9728;</span>
                <input type="range" id="splatExposure" min="0.2" max="3" step="0.05" value="<%= splat.exposure || 1 %>" aria-label="Exposure">
            </label>
            <button id="splatSetView" type="button" title="Save the current camera as the view everyone starts at">Set default view</button>
            <button id="splatClearView" type="button" title="Go back to automatic framing"<%= splat.view ? '' : ' hidden' %>>Clear</button>
            <% } %>
            <button id="splatReset" type="button">Reset view</button>
            <button id="splatFull" type="button" title="Fullscreen" aria-label="Fullscreen">&#9974;</button>
        </div>
    </header>

    <main class="splat-stage" id="splatStage">
        <canvas id="splatCanvas"></canvas>

        <div class="splat-loading" id="splatLoading"<% if (splat.thumb_path) { %> style="background-image: url('<%= imgUrl(splat.thumb_path, 1600) %>');"<% } %>>
            <div class="splat-loading-inner">
                <div class="splat-progress"><span class="splat-progress-bar" id="splatBar"></span></div>
                <div class="splat-progress-label" id="splatLabel">Loading&hellip;</div>
            </div>
        </div>

        <div class="splat-hint" id="splatHint">Drag to orbit &middot; scroll to zoom &middot; right-drag to pan</div>
        <% if (isOwner) { %>
        <%# What the adaptive quality settled on — only you see this. %>
        <div class="splat-quality" id="splatQuality" hidden></div>
        <% } %>
        <div class="splat-mobile-note" id="splatMobileNote">Quality adjusts itself to your device &mdash; a desktop will usually show more detail.</div>
        <% if (splat.description) { %>
        <div class="splat-caption"><%- nl2br(splat.description) %></div>
        <% } %>
        <div class="splat-error" id="splatError" hidden></div>
    </main>

    <script src="/js/splat-viewer.js"
            data-src="<%= splat.splat_url %>"
            data-format="<%= splat.splat_format %>"
            data-flip="<%= splat.flip_up ? '1' : '0' %>"
            data-exposure="<%= splat.exposure || 1 %>"
            data-view="<%= splat.view ? JSON.stringify(splat.view) : '' %>"
            data-id="<%= splat.id %>"></script>
</body>
</html>
