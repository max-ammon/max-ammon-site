<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head', { title: title }) %>
    <link rel="stylesheet" href="/css/demo.css">
</head>
<body>
<%- include('../partials/nav', { navVariant: 'main' }) %>

<%# Two floating hints over everything else: one with an arrow up at the Project
    Gallery button in the header, one with an arrow down into the page. They stay
    put until the visitor moves the page, then fade. The script measures the
    header and the button, so the arrows land correctly at any width. Editable
    under Admin -> Text; blank either to switch that hint off. %>
<% if (content['hint.gallery']) { %>
<div class="site-hint site-hint-gallery" id="hintGallery" role="status">
    <svg class="site-hint-arrow" viewBox="0 0 24 52" aria-hidden="true" focusable="false">
        <path d="M12 50 V 8" />
        <path d="M4 17 L12 4 L20 17" />
    </svg>
    <div class="site-hint-box"><%- content['hint.gallery'] %></div>
</div>
<% } %>
<% if (content['hint.welcome']) { %>
<div class="site-hint site-hint-welcome" id="hintWelcome" role="status">
    <div class="site-hint-box"><%- content['hint.welcome'] %></div>
    <%# Short on purpose, and shortened further by the script if the demo starts
        close underneath: a thin light stroke over the poster image is invisible. %>
    <svg class="site-hint-arrow" viewBox="0 0 24 28" preserveAspectRatio="xMidYMax meet" aria-hidden="true" focusable="false">
        <path d="M12 2 V 19" vector-effect="non-scaling-stroke" />
        <path d="M5 15 L12 26 L19 15" vector-effect="non-scaling-stroke" />
    </svg>
</div>
<% } %>

    <section id="demo">
        <div style="padding-top:50px" class="nopadding">
            <%# The archive link is an absolutely-positioned child of this
                wrapper, so it rides beside the heading without taking part in
                the layout — the embed below is completely unaffected. %>
            <div class="demo-head">
                <h2><%= content['demo.title'] %></h2>
                <a class="demo-archive-link" href="/demo-archive"><%= content['demoarchive.button'] || 'Demo Archive' %></a>
            </div>
            <p><%= content['demo.year'] %></p>
                <div class="demobox">
                    <%# data-scroll-shrink: the play button is full size while the
                        demo is what you are looking at, and shrinks away as you
                        scroll on past it (see /js/skill-scroll.js). %>
                    <div class="demo-embed" data-scroll-shrink data-youtube="<%= settings.demo_youtube_id %>" style="aspect-ratio: <%= settings.demo_aspect_w %> / <%= settings.demo_aspect_h %>;">
                        <%# The hero image: loaded eagerly and prioritised — everything below is lazy. %>
                        <img class="demo-poster" src="<%= imgUrl(settings.demo_poster, 1600) %>"
                             srcset="<%= imgSrcset(settings.demo_poster, [800, 1200, 1600, 2400, 3200]) %>"
                             sizes="100vw" fetchpriority="high" decoding="async" alt="demothumbnail">
                        <img src="/assets/paths/demo_thumbnail_button.svg" alt="playbuttonsvg" class="playbutton-svg demo-play" style="width: 7%;">
                        <%# Swapped in for the play triangle once the video has run to the end. %>
                        <img src="/assets/paths/demo_replay_button.svg" alt="replaybuttonsvg" class="playbutton-svg demo-replay">
                    </div>
                </div>
            <div class="barrior nopadding"></div>
        </div>
    </section>

    <section id="skills">
        <div style="padding-top:50px" class="nopadding" >
            <h2><%= content['skills.heading'] %></h2>
        </div>

        <div class="skills-pipeline">
        <% var _markers = (typeof markers !== 'undefined' && markers) ? markers : []; %>
        <div class="pipeline-rail" aria-hidden="true">
            <span class="pipeline-cap"><%= content['skills.pipeline.start'] %></span>
            <span class="pipeline-line">
                <span class="pipeline-titles">
                    <% for (var i = 0; i < 4; i++) { %><span class="pipeline-title"><%= content['skills.pipeline.title'] %></span><% } %>
                </span>
                <span class="pipeline-dot"></span>
                <%# Owner-placed software logos, positioned along the bar (0=top .. 100=bottom). %>
                <% _markers.forEach(function (m) { %>
                <span class="pipeline-marker<%= m.vertical ? ' vertical' : '' %>" data-pos="<%= m.position %>" style="top: <%= m.position %>%;">
                    <span class="pm-icon"><img src="<%= imgUrl(m.image_path, 480) %>" alt="<%= m.label %>" loading="lazy" decoding="async"></span>
                    <% if (m.label) { %><span class="pm-label"><%= m.label %></span><% } %>
                </span>
                <% }); %>
            </span>
            <span class="pipeline-cap"><%= content['skills.pipeline.end'] %></span>
        </div>

        <div class="modelingbox" style="position:relative">
            <div class="modelingtext">
                <h3><%= content['skills.modeling.title'] %></h3>
                <%- paragraphs(content['skills.modeling.body']) %>
            </div>
            <%# The pair scales with the section: smallest as it arrives and
                leaves, natural size when centred (see /js/skill-scroll.js).
                transform never affects layout, so nothing around them moves. %>
            <div style="display:inline-flex" data-scroll-scale>
                <img style="max-width: 50%;" src="<%= imgUrl(settings.skills_modeling_img1, 1200) %>"
                     srcset="<%= imgSrcset(settings.skills_modeling_img1, [480, 800, 1200, 1600]) %>"
                     sizes="50vw" loading="lazy" decoding="async" alt="">
                <img style="max-width: 50%;" src="<%= imgUrl(settings.skills_modeling_img2, 1200) %>"
                     srcset="<%= imgSrcset(settings.skills_modeling_img2, [480, 800, 1200, 1600]) %>"
                     sizes="50vw" loading="lazy" decoding="async" alt="">
            </div>
        </div>

        <div style="padding-top: 0%;">
            <div class="texturingtext">
                <h3><%= content['skills.texturing.title'] %></h3>
                <%- paragraphs(content['skills.texturing.body']) %>
            </div>
            <div style="padding-top: 1%">
                <%# Texturing: one picture, or a sequence scrubbed by scroll position
                    (see /js/skill-scroll.js). With fewer than two frames configured
                    this renders the plain <img> it always was, so the layout has
                    nothing new to get wrong. The frames stop at 2000px rather than
                    the 3200 the single picture offers: a whole sequence is
                    downloaded to play it, and sixteen of the largest size is a lot
                    of picture for something no single frame is dwelt on. %>
                <%# A background picture turns the sequence into a set of overlays:
                    the detail is downloaded once, at full size, and each frame
                    carries only what changes over it — which is what makes a long
                    sequence affordable. Without one the frames carry the whole
                    picture themselves and the first of them is the plate. %>
                <%# Layers are the other way of building this picture: whole layers
                    of the asset over the same background, cut into a band of slits
                    that travels across it. They take precedence when they are
                    there, and they need the background, since the slits are cut
                    into it — so emptying either one puts the sequence below back
                    exactly as it was. Served at the background's own sizes: a slit
                    shows its layer at the same scale as the picture around it, and
                    they share a `sizes`, so the browser picks the same width for
                    all of them and no slit is ever softer than the plate. %>
                <% var texturingPlate = String(settings.skills_texturing_frames_base || '').trim(); %>
                <% var texturingSlit = Number(settings.skills_texturing_slit_pct || 6.5) || 6.5; %>
                <% if (texturingPlate && texturingLayers && texturingLayers.length) { %>
                <span class="texturingimage slit-layers" data-slit-layers data-slit="<%= texturingSlit %>">
                    <span class="sl-plate">
                        <img src="<%= imgUrl(texturingPlate, 1600) %>"
                             srcset="<%= imgSrcset(texturingPlate, [800, 1200, 1600, 2400, 3200]) %>"
                             sizes="100vw" loading="eager" decoding="async" alt="">
                    </span>
                    <% texturingLayers.forEach(function (layer, i) { %>
                    <%# --i is the slit this layer owns: the script gives the stack
                        where the band starts and how wide a slit is, and each layer
                        adds its own index to find its place in it. %>
                    <span class="sl" style="--i: <%= i %>">
                        <img src="<%= imgUrl(layer, 1600) %>"
                             srcset="<%= imgSrcset(layer, [800, 1200, 1600, 2400, 3200]) %>"
                             sizes="100vw" loading="lazy" decoding="async" alt="">
                    </span>
                    <% }); %>
                </span>
                <% } else if (texturingFrames && texturingFrames.length > 1) { %>
                <span class="texturingimage scrub-frames<%= texturingPlate ? ' has-plate' : '' %>" data-scrub-frames>
                    <% if (texturingPlate) { %>
                    <%# In flow, so the stack is its size and every frame is laid over
                        it. Never deferred: it is the picture, and the frames are
                        holes in a sheet over it. %>
                    <span class="sf-plate">
                        <img src="<%= imgUrl(texturingPlate, 1600) %>"
                             srcset="<%= imgSrcset(texturingPlate, [800, 1200, 1600, 2400, 3200]) %>"
                             sizes="100vw" loading="eager" decoding="async" alt="">
                    </span>
                    <% } %>
                    <% texturingFrames.forEach(function (frame, i) { %>
                    <span class="sf<%= i === 0 ? ' sf-base' : '' %>">
                        <img src="<%= imgUrl(frame, 2000) %>"
                             srcset="<%= imgSrcset(frame, [800, 1200, 1600, 2000]) %>"
                             <%# The first frame is what the section shows before the
                                 sequence starts, so it is not deferred; the rest are. %>
                             sizes="100vw" loading="<%= i === 0 ? 'eager' : 'lazy' %>" decoding="async" alt="">
                    </span>
                    <% }); %>
                </span>
                <% } else { %>
                <img class="texturingimage" src="<%= imgUrl(settings.skills_texturing_img, 1600) %>"
                     srcset="<%= imgSrcset(settings.skills_texturing_img, [800, 1200, 1600, 2400, 3200]) %>"
                     sizes="100vw" loading="lazy" decoding="async" alt="">
                <% } %>
            </div>

        <div style="padding-top: 50px;">
            <div>
                <div class="animationtext">
                    <h3><%= content['skills.animation.title'] %></h3>
                    <%- paragraphs(content['skills.animation.body']) %>
                </div>
                <%# Animation: one picture, or a stack of frames that cross-fade
                    as the section scrolls past (see /js/skill-scroll.js). With
                    no extra frames configured this renders the plain <img> it
                    always was, so the layout has nothing new to get wrong. %>
                <%
                  var animFrames = [settings.skills_animation_img, settings.skills_animation_img2, settings.skills_animation_img3]
                    .map(function (v) { return String(v || '').trim(); })
                    .filter(Boolean);
                %>
                <% if (animFrames.length > 1) { %>
                <span class="animationimage anim-frames" data-anim-frames>
                    <% animFrames.forEach(function (frame, i) { %>
                    <%# --frame-src masks the tint with this frame's own alpha; 800px
                        is plenty for a mask edge and is usually the very file the
                        <img> below already picked from its srcset. %>
                    <span class="af<%= i === 0 ? ' af-base' : '' %>" style="--frame-src: url('<%= imgUrl(frame, 800) %>')">
                        <img src="<%= imgUrl(frame, 1200) %>"
                             srcset="<%= imgSrcset(frame, [480, 800, 1200, 1600]) %>"
                             sizes="50vw" loading="lazy" decoding="async" alt="">
                    </span>
                    <% }); %>
                </span>
                <% } else { %>
                <img class="animationimage" src="<%= imgUrl(settings.skills_animation_img, 1200) %>"
                     srcset="<%= imgSrcset(settings.skills_animation_img, [480, 800, 1200, 1600]) %>"
                     sizes="50vw" loading="lazy" decoding="async" alt="">
                <% } %>
            </div>
        </div>

        <div style="padding-top: 100px;display: inline-flex; padding-bottom: 100px;">
            <%# Compositing & grading: one picture, or a sequence whose frames are
                wiped in from the left, finishing on the last one as the picture
                reaches the middle of the screen (see /js/skill-scroll.js). With
                fewer than two frames this renders the plain <img> it always was.
                Same sizes as the Texturing sequence and for the same reason: the
                whole thing is downloaded to play it, so it stops short of what a
                single picture can afford. %>
            <% if (gradingFrames && gradingFrames.length > 1) { %>
            <span class="gradingimage wipe-frames" data-wipe-frames>
                <% gradingFrames.forEach(function (frame, i) { %>
                <span class="wf<%= i === 0 ? ' wf-base' : '' %>">
                    <img src="<%= imgUrl(frame, 2000) %>"
                         srcset="<%= imgSrcset(frame, [480, 800, 1200, 1600, 2000]) %>"
                         <%# The first frame is what the section shows before the
                             sequence starts, so it is not deferred; the rest are. %>
                         sizes="45vw" loading="<%= i === 0 ? 'eager' : 'lazy' %>" decoding="async" alt="">
                </span>
                <% }); %>
            </span>
            <% } else { %>
            <img class="gradingimage" src="<%= imgUrl(settings.skills_grading_img, 1200) %>"
                 srcset="<%= imgSrcset(settings.skills_grading_img, [480, 800, 1200, 1600]) %>"
                 sizes="45vw" loading="lazy" decoding="async" alt="">
            <% } %>
            <div class="gradingtext">
                <h3><%= content['skills.grading.title'] %></h3>
                <%- paragraphs(content['skills.grading.body']) %>
            </div>
        </div>
        </div><%# closes the (originally unclosed) padding-top:0% wrapper %>
        <%# The rail is hidden on small screens, so the software shows here as a plain list instead. %>
        <% if (_markers.length) { %>
        <% if (content['skills.software.note']) { %><p class="skills-software-note"><%= content['skills.software.note'] %></p><% } %>
        <ul class="skills-software" aria-label="Software I use">
            <% _markers.forEach(function (m) { %>
            <li><img src="<%= imgUrl(m.image_path, 480) %>" alt="<%= m.label %>" loading="lazy" decoding="async"><% if (m.label) { %><span><%= m.label %></span><% } %></li>
            <% }); %>
        </ul>
        <% } %>
        </div><%# closes .skills-pipeline — the rail spans exactly these four skills %>
        <div class="barrior nopadding"></div>
    </section>

    <section id="about">
        <%# The banner comes in soft and sharpens as the section arrives, clear by
            the time the profile picture below it is completely on screen (see
            /js/skill-scroll.js). The span is what clips it: a blurred picture
            fades out past its own edges, so while it is soft it is drawn a little
            larger and the box keeps the soft edge out of sight. %>
        <span class="about-banner">
            <img data-scroll-unblur="#profilepic" style="max-width: 100%;" src="<%= imgUrl(settings.about_banner, 1600) %>"
                 srcset="<%= imgSrcset(settings.about_banner, [800, 1200, 1600, 2400, 3200]) %>"
                 sizes="100vw" loading="lazy" decoding="async" alt="">
        </span>
        <div style="display:inline-flex;padding:75px;">
            <div>
                <%# The circle is the box now and the picture sits inside it, so the
                    picture can be zoomed without the mask moving with it: it starts
                    a tenth in and settles at its natural framing as the section
                    comes into view (see /js/skill-scroll.js). The id stays on the
                    mask, which is what every rule that sized and placed this
                    picture was written against. %>
                <span id="profilepic">
                    <%# The sizes are the circle and a half, because that is how large
                        this is actually drawn while it arrives — a file picked for
                        the resting size would be soft for the whole of the zoom,
                        and a browser chooses once and never revisits it for a
                        transform. %>
                    <img data-scroll-zoom src="<%= imgUrl(settings.about_profile, 800) %>"
                         srcset="<%= imgSrcset(settings.about_profile, [480, 800, 1200]) %>"
                         sizes="(max-width: 1500px) 375px, (max-width: 2048px) 600px, 750px"
                         loading="lazy" decoding="async" alt="">
                </span>
            </div>
            <div>
                <div style="padding-left: 75px;">
                    <h2 style="text-align: left;"><%= content['about.heading'] %></h2>
                    <div style="padding-top: 20px;">
                        <%- paragraphs(content['about.body']) %>
                    </div>
                </div>
            </div>
        </div>
        <div class="barrior nopadding"></div>
    </section>

    <section id="contact" style="padding-top: 25px;">
        <h2><%= content['contact.heading'] %></h2>
        <% var cflash = (typeof contactStatus !== 'undefined') ? contactStatus : ''; %>
        <% if (cflash === 'sent') { %><p class="contact-flash ok">Thanks — your message has been sent!</p><% } %>
        <% if (cflash === 'error') { %><p class="contact-flash err">Please enter your name, a valid email, and a message, then try again.</p><% } %>
        <% if (cflash === 'throttled') { %><p class="contact-flash err">Too many messages just now — please try again in a little while.</p><% } %>
        <div class="contact-columns">
            <div class="contact-form-wrap">
                <form class="contact-form" method="post" action="/contact">
                    <input type="text" name="name" placeholder="Your name" required>
                    <input type="email" name="email" placeholder="Your email" required>
                    <input type="text" name="subject" placeholder="Subject (optional)">
                    <textarea name="message" placeholder="Your message" rows="5" required></textarea>
                    <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
                    <button type="submit">Send message</button>
                </form>
            </div>
            <div class="contact-info">
                <%
                  var contactRows = [
                    { label: 'Email',    key: 'contact.email' },
                    { label: 'Internet', key: 'contact.internet' },
                    { label: 'YouTube',  key: 'contact.youtube' },
                    { label: 'LinkedIn', key: 'contact.linkedin' },
                    { label: 'Xing',     key: 'contact.xing' }
                  ];
                  contactRows.forEach(function (item) {
                    var val = String(content[item.key] || '').trim();
                    if (!val) return;
                    // Turn the stored value into a clean, clickable link: mailto for an
                    // email, https for a URL/bare domain, and a tidied display string
                    // (no scheme / www / trailing slash). Anything else stays plain text.
                    var href = '', text = val, external = false;
                    if (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) {
                      href = 'mailto:' + val;
                    } else if (/^https?:\/\//i.test(val)) {
                      href = val; external = true;
                      text = val.replace(/^https?:\/\//i, '').replace(/^www\./i, '').replace(/\/+$/, '');
                    } else if (/^[\w.-]+\.[a-z]{2,}(\/\S*)?$/i.test(val)) {
                      href = 'https://' + val; external = true;
                      text = val.replace(/^www\./i, '').replace(/\/+$/, '');
                    }
                %>
                <%# Label and value are one unit now that the details sit in a
                    horizontal strip: they must wrap to the next line together. %>
                <span class="ci-item">
                    <span class="ci-label lighttitle"><%= item.label %></span>
                    <% if (href) { %>
                    <a class="ci-value secondarytitle" href="<%= href %>"<% if (external) { %> target="_blank" rel="noopener noreferrer"<% } %>><%= text %></a>
                    <% } else { %>
                    <span class="ci-value secondarytitle"><%= val %></span>
                    <% } %>
                </span>
                <% }); %>
            </div>
        </div>
    </section>

    <%- include('../partials/footer-bar') %>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Apply tabindex="-1" to all headings
            document.querySelectorAll("h1, h2, h3, h4, h5, h6").forEach(function (heading) {
                heading.setAttribute("tabindex", "-1");

                // Remove focus when clicked
                heading.addEventListener("click", function () {
                    setTimeout(() => document.body.focus(), 10);
                });
            });

            // If URL changes (e.g., clicking an anchor link), remove focus
            window.addEventListener("hashchange", function () {
                setTimeout(() => document.body.focus(), 10);
            });

            // Prevent focus on page load if there's a hash in the URL
            if (window.location.hash) {
                setTimeout(() => document.body.focus(), 10);
            }
        });
    </script>

<%# (shrink-on-scroll now ships with the nav partial itself) %>
    <script src="/js/demo.js"></script>
    <script src="/js/pipeline.js"></script>
    <script src="/js/scrollspy.js"></script>
    <script src="/js/nav-scroll.js"></script>
    <script src="/js/site-hints.js"></script>
    <script src="/js/skill-scroll.js"></script>

</body>
</html>
