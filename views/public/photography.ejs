<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head', { title: title }) %>
    <link rel="stylesheet" href="/css/photography.css">
</head>
<body>
<%- include('../partials/nav', { navVariant: 'photography' }) %>

<section id="photography">
    <div style="padding-top: 50px; text-align: center;">
        <h2><%= content['photography.heading'] || 'Photography' %></h2>
        <% if (content['photography.intro']) { %>
        <p class="secondarytitle" style="max-width: 820px; margin: 0 auto; padding: 15px 5vw 0; font-size: 1.4cap; line-height: 1.5;"><%- content['photography.intro'] %></p>
        <% } %>
    </div>

    <% if (!rows || !rows.length) { %>
    <div style="padding: 60px 5vw 100px; text-align: center;">
        <p class="secondarytitle">No photos have been added yet.</p>
    </div>
    <% } else { %>
    <%# Justified rows: within a row every image is scaled to the same height and
        its width comes from its own aspect ratio (flex-grow: ratio), so the row
        fills the page width exactly and nothing is cropped. A short final row is
        padded with invisible spacers so its photos keep the size of the rows
        above instead of stretching. %>
    <div class="photo-rows">
        <% rows.forEach(function (row) { %>
        <%
          // Each photo's real share of the page width — its ratio over the row's
          // total growth (spacers grow 1.5, matching the CSS). This is what the
          // `sizes` hint needs: with owner-composed rows a photo alone in its row
          // is full-bleed, so a fixed "100/columns" guess would have the browser
          // download a far too small file for it.
          var rowTotal = row.items.reduce(function (sum, x) { return sum + x.ratio; }, 0) + row.spacers * 1.5;
        %>
        <div class="photo-row">
            <% row.items.forEach(function (p) { var sharePct = Math.max(5, Math.round((p.ratio / rowTotal) * 100)); %>
            <figure class="photo-item" style="flex-grow: <%= p.ratio %>;">
                <img src="<%= imgUrl(p.image_path, 1200) %>"
                     srcset="<%= imgSrcset(p.image_path, [480, 800, 1200, 1600, 2400]) %>"
                     sizes="(max-width: 700px) 100vw, <%= sharePct %>vw"
                     style="aspect-ratio: <%= p.ratio %>;"
                     loading="lazy" decoding="async" alt="<%= p.title %>">
                <% if (p.date_text) { %><figcaption class="photo-date"><%= p.date_text %></figcaption><% } %>
            </figure>
            <% }); %>
            <% for (var s = 0; s < row.spacers; s++) { %><span class="photo-spacer" aria-hidden="true"></span><% } %>
        </div>
        <% }); %>
    </div>
    <% } %>
</section>

<%- include('../partials/footer-bar') %>
</body>
</html>
